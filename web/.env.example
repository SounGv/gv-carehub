# URL ของ Google Apps Script Web App (Deploy > New deployment > Web app)
# ตัวอย่าง: https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
NEXT_PUBLIC_GV_API_URL=

# Supabase (fast-path reads/writes — dashboard + claim creation; falls back to
# Apps Script automatically if unset). anon key only — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staff/admin login (email magic-link via NextAuth Credentials + Zoho SMTP,
# gated by an explicit staff allowlist — @gadgetvilla.co.th isn't a Google
# Workspace domain, so there's no real Google identity to check against).
# Set these in the Vercel dashboard, never in code.
# AUTH_SECRET: any random 32+ byte string — also signs the magic-link token.
# AUTH_URL: the deployed site's origin, e.g. https://gv-carehub.vercel.app
# STAFF_ALLOWED_EMAILS: comma-separated list of emails allowed to log in.
# ZOHO_SMTP_HOST/PORT/USER/PASS/FROM: the sending mailbox's SMTP credentials
#   (Zoho Mail > Settings > Security > App Passwords for ZOHO_SMTP_PASS).
AUTH_SECRET=
AUTH_URL=
STAFF_ALLOWED_EMAILS=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=
