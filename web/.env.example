# URL ของ Google Apps Script Web App (Deploy > New deployment > Web app)
# ตัวอย่าง: https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
NEXT_PUBLIC_GV_API_URL=

# Supabase (fast-path reads/writes — dashboard + claim creation; falls back to
# Apps Script automatically if unset). anon key only — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staff/admin login (Google Workspace SSO via NextAuth, restricted to
# @gadgetvilla.co.th) — set these in the Vercel dashboard, never in code.
# AUTH_SECRET: any random 32+ byte string.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from a Google Cloud OAuth client
#   (Authorized redirect URI: https://<your-domain>/api/auth/callback/google)
# AUTH_URL: the deployed site's origin, e.g. https://gv-carehub.vercel.app
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=
